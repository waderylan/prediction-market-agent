# Copy this file to .env and replace placeholders locally. Never commit .env.
OPENAI_API_KEY=replace-with-openai-api-key
TAVILY_API_KEY=replace-with-tavily-api-key
AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key

# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
JEV_ENABLED=false
LOG_LEVEL=INFO
PORT=8080
