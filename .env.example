# Copy this file to .env and replace placeholders locally. Never commit .env.
OPENAI_API_KEY=replace-with-openai-api-key

# Optional. Leave blank for Tavily MCP keyless mode or supply a Tavily API key for account usage.
TAVILY_API_KEY=

# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
LOG_LEVEL=INFO
PORT=8080
