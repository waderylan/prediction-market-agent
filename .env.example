# Copy this file to .env and set one model key locally. Never commit .env.
# Gemini takes precedence when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GCP_PROJECT_ID=

# Optional alternative for OpenAI or the local Kessel gateway.
OPENAI_API_KEY=

# Optional. Leave blank for Tavily MCP keyless mode or supply a Tavily API key for account usage.
TAVILY_API_KEY=

# OpenAI/Kessel overrides; ignored when Gemini is selected.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
LOG_LEVEL=INFO
PORT=8080
