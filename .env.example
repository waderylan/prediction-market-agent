# Copy this file to .env and replace placeholders locally. Never commit .env.
OPENAI_API_KEY=replace-with-openai-api-key

# Optional. Leave blank for Tavily MCP keyless mode or supply a Tavily API key for account usage.
TAVILY_API_KEY=

# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5
LOG_LEVEL=INFO
PORT=8080

# Watch storage. SQLite is complete for local use; Cloud Run uses Firestore.
WATCH_STORAGE=sqlite
WATCH_SQLITE_PATH=artifacts/watches.db
GCP_PROJECT_ID=
SCHEDULER_OIDC_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=

# Optional Telegram projection. Keep blank for inbox-only delivery.
# Cloud Run can set TELEGRAM_BOT_TOKEN_SECRET to a Secret Manager secret ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_SECRET=
TELEGRAM_CHAT_ID=
